{
  "name": "@rodit/rodit-auth-fe",
  "version": "4.10.16",
  "description": "Browser NEAR Passport / RODiT client: NEP-413 wallet login, on-chain ownership checks, and JWT sessions for agent APIs",
  "main": "index.js",
  "browser": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./chain": {
      "types": "./chain.d.ts",
      "default": "./chain.js"
    }
  },
  "scripts": {
    "build": "echo 'SDK build complete - no build step required for this package'",
    "test": "node --test test/*.cjs",
    "lint": "eslint .",
    "docs": "jsdoc -c jsdoc.json"
  },
  "keywords": [
    "rodit",
    "near",
    "near-protocol",
    "agent",
    "passport",
    "web3",
    "authentication",
    "nep-413",
    "jwt",
    "sdk"
  ],
  "author": "Discernible IO",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "bs58": "^5.0.0",
    "jwt-decode": "^4.0.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "eslint": "^8.40.0",
    "jsdoc": "^4.0.2"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "chain.js",
    "chain.d.ts",
    "utils.js",
    "lib/**/*.js",
    "frontend/**/*.js",
    "services/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discernible-io/rodit-sdk.git",
    "directory": "rodit-auth-fe"
  },
  "bugs": {
    "url": "https://github.com/discernible-io/rodit-sdk/issues"
  },
  "homepage": "https://github.com/discernible-io/rodit-sdk/tree/main/rodit-auth-fe#readme",
  "publishConfig": {
    "access": "public"
  }
}
